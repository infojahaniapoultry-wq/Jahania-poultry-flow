# Client environment — copy to .env.local for local development
# On Vercel, set NEXT_PUBLIC_API_URL in the project's Environment Variables dashboard

# URL of the NestJS backend API (no trailing slash)
# Local:   http://localhost:3010/api
# Vercel:  https://your-api-name.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:3010/api

# Optional Supabase browser client configuration. These are safe to expose to
# the browser, but do not grant direct database access. The Nest API remains
# the source of truth for the application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
