# Neon PostgreSQL connection for the API and Prisma migrations.
# Use a pooled Neon URL for DATABASE_URL when deploying serverless functions.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/DATABASE?sslmode=require"

# Use the direct Neon endpoint for Prisma migrations when Neon provides one.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/DATABASE?sslmode=require"

# Generate a long, random value for production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Set this to the deployed frontend URL so API CORS allows the browser app.
FRONTEND_URL="https://your-frontend.vercel.app"

# Vercel supplies the port for serverless functions; this is useful for local use.
PORT=3010
