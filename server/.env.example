# Supabase transaction pooler for the Vercel/serverless API (port 6543).
# Copy this from Supabase Dashboard → Connect → Transaction pooler.
# Prisma needs pgbouncer=true when using transaction pooling.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase direct connection for Prisma migrations (or Session pooler on port
# 5432 when the machine running migrations does not support IPv6).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Generate a long, random value for production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Set this to the deployed frontend URL so API CORS allows the browser app.
FRONTEND_URL="https://your-frontend.vercel.app"

# Vercel supplies the port for serverless functions; this is useful for local use.
PORT=3010
