# Use the pooled connection string for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Use the direct database connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Generate a long, random value for production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Set this to the deployed frontend URL so API CORS allows the browser app.
FRONTEND_URL="https://your-frontend.vercel.app"

# Vercel supplies the port for serverless functions; this is useful for local use.
PORT=3010
