// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  DATA_ENTRY
}
enum VoucherType {
  DEBIT
  CREDIT
  RECOVERY
  EXPENSE
  PURCHASE
}

enum PaymentMode {
  CASH
  UDHAR
  ONLINE
  CHEQUE
}

enum PaymentStatus {
  PENDING
  OUTSTANDING
  COMPLETED
  FAILED
  BOUNCED
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum OnlineProvider {
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  OTHER
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum MarketRateBaseType {
  FARM
  FINAL
}

enum PricingOffsetDirection {
  PLUS
  MINUS
}

enum CashBookType {
  RECEIPT
  PAYMENT
}

// ============================================================
// USERS
// ============================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(DATA_ENTRY)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// VENDORS / FARMERS
// ============================================================

model Vendor {
  id             Int      @id @default(autoincrement())
  name           String
  contact        String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases      PurchaseEntry[]
  ledgerEntries  VendorLedger[]
  vouchers       Voucher[]
}

model VendorLedger {
  id             Int             @id @default(autoincrement())
  vendorId       Int
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  date           DateTime        @default(now())
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  runningBalance Decimal         @db.Decimal(12, 2)
  narration      String?
  referenceId    Int?
  referenceType  String?         // 'PURCHASE' | 'VOUCHER'
  createdAt      DateTime        @default(now())

  @@index([vendorId, date])
  @@index([referenceType, referenceId])
}

// ============================================================
// CUSTOMERS / SHOPS
// ============================================================

model Customer {
  id             Int      @id @default(autoincrement())
  shopName       String
  contact        String?
  address        String?
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  pricingBaseRateType MarketRateBaseType?
  pricingOffsetDirection PricingOffsetDirection?
  pricingOffsetValue Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices         Invoice[]
  ledgerEntries    CustomerLedger[]
  vouchers         Voucher[]
  routeAllocations DriverRouteAllocation[]
}

model MarketRate {
  id            Int      @id @default(autoincrement())
  effectiveDate DateTime @db.Date
  farmRate      Decimal  @db.Decimal(10, 2)
  finalRate     Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([effectiveDate])
  @@index([effectiveDate])
}

model CustomerLedger {
  id             Int             @id @default(autoincrement())
  customerId     Int
  customer       Customer        @relation(fields: [customerId], references: [id])
  date           DateTime        @default(now())
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  runningBalance Decimal         @db.Decimal(12, 2)
  narration      String?
  referenceId    Int?
  referenceType  String?         // 'INVOICE' | 'VOUCHER'
  createdAt      DateTime        @default(now())

  @@index([customerId, date])
  @@index([referenceType, referenceId])
}

// ============================================================
// DRIVERS / RIDERS
// ============================================================

model Driver {
  id             Int      @id @default(autoincrement())
  name           String
  contact        String?
  vehicleType    String?
  defaultCharge  Decimal  @default(0) @db.Decimal(12, 2)
  advanceBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transportAdvances TransportAdvance[]
  ledgerEntries     DriverLedger[]
  purchases         PurchaseEntry[]
  invoices          Invoice[]
  routes            DriverRoute[]
}

model DriverRoute {
  id          Int      @id @default(autoincrement())
  driverId    Int
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  name        String
  truckNo     String?
  truckType   String?
  routeCharge Decimal? @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations DriverRouteAllocation[]
  invoices    Invoice[]

  @@index([driverId])
}

model DriverRouteAllocation {
  id           Int         @id @default(autoincrement())
  routeId      Int
  route        DriverRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  customerId   Int
  customer     Customer    @relation(fields: [customerId], references: [id])
  sortOrder    Int         @default(0)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([routeId])
  @@index([customerId])
}

model DriverLedger {
  id             Int             @id @default(autoincrement())
  driverId       Int
  driver         Driver          @relation(fields: [driverId], references: [id])
  date           DateTime        @default(now())
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  runningBalance Decimal         @db.Decimal(12, 2)
  narration      String?
  referenceId    Int?
  referenceType  String?
  createdAt      DateTime        @default(now())

  @@index([driverId, date])
}

// ============================================================
// PURCHASE ENTRY MODULE
// ============================================================

model PurchaseEntry {
    id            Int      @id @default(autoincrement())
    date          DateTime @default(now())
    vendorId      Int
    vendor        Vendor   @relation(fields: [vendorId], references: [id])
    driverId      Int?
    driver        Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
    driverCharge  Decimal  @default(0) @db.Decimal(12, 2)
    weightKg      Decimal  @default(0) @db.Decimal(10, 3)
    ratePerKg     Decimal  @db.Decimal(10, 2)
    purchaseAmount Decimal @db.Decimal(12, 2)   // weightKg * ratePerKg
  settledAmount Decimal   @default(0) @db.Decimal(12, 2)
  paymentMode   PaymentMode @default(CASH)
  paymentStatus PaymentStatus @default(COMPLETED)
  paymentReference String?
  paymentProvider OnlineProvider?
  chequeLogId   Int?     @unique
  onlinePaymentLogId Int? @unique
  chequeLog     ChequeLog? @relation("PurchaseChequeLog", fields: [chequeLogId], references: [id], onDelete: SetNull)
  onlinePaymentLog OnlinePaymentLog? @relation("PurchaseOnlinePaymentLog", fields: [onlinePaymentLogId], references: [id], onDelete: SetNull)
  notes         String?
  isVoided      Boolean  @default(false)
  voidReason    String?
  voidedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date, isVoided])
  @@index([vendorId, isVoided])
  @@index([driverId])
}

// ============================================================
// INVOICE / SALES MODULE
// ============================================================

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique  // e.g., INVOICE-00001
  date            DateTime      @default(now())
  customerId      Int
  customer        Customer      @relation(fields: [customerId], references: [id])
  driverId        Int?
  driver          Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverCharge    Decimal       @default(0) @db.Decimal(12, 2)
  routeId         Int?
  route           DriverRoute?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeSnapshot   Json?
  previousBalance Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)   // sum of line items
  totalBalance    Decimal       @db.Decimal(12, 2)   // totalAmount + previousBalance
  settledAmount   Decimal      @default(0) @db.Decimal(12, 2)
  paymentMode     PaymentMode   @default(CASH)
  paymentStatus   PaymentStatus @default(COMPLETED)
  paymentReference String?
  paymentProvider OnlineProvider?
  chequeLogId     Int?          @unique
  onlinePaymentLogId Int?       @unique
  chequeLog       ChequeLog?    @relation("InvoiceChequeLog", fields: [chequeLogId], references: [id], onDelete: SetNull)
  onlinePaymentLog OnlinePaymentLog? @relation("InvoiceOnlinePaymentLog", fields: [onlinePaymentLogId], references: [id], onDelete: SetNull)
  notes           String?
  isVoided        Boolean      @default(false)
  voidReason      String?
  voidedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]

  @@index([date, isVoided])
  @@index([customerId, isVoided])
  @@index([driverId])
}

model InvoiceItem {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description   String?
  firstWeight   Decimal @db.Decimal(14, 3)   // Quantity / sold weight
  secondWeight  Decimal @db.Decimal(14, 3)   // Legacy empty crates weight
  netWeight     Decimal @db.Decimal(14, 3)   // firstWeight - secondWeight (auto)
  ratePerKg     Decimal @db.Decimal(10, 2)
  amount        Decimal @db.Decimal(12, 2)   // netWeight * ratePerKg (auto)
}

// ============================================================
// VOUCHER SYSTEM
// ============================================================

model Voucher {
  id          Int         @id @default(autoincrement())
  voucherNo   String      @unique
  type        VoucherType
  date        DateTime    @default(now())
  customerId  Int?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  vendorId    Int?
  vendor      Vendor?     @relation(fields: [vendorId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  narration   String?
  reference   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ============================================================
// EXPENSE MANAGEMENT
// ============================================================

model ExpenseAccount {
  id        Int      @id @default(autoincrement())
  name      String   @unique  // e.g., Mazda Diesel, Rider Salary
  category  String?           // e.g., Vehicle, Rider, Home, Office
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries   ExpenseEntry[]
}

model ExpenseEntry {
  id               Int            @id @default(autoincrement())
  date             DateTime       @default(now())
  expenseAccountId Int
  expenseAccount   ExpenseAccount @relation(fields: [expenseAccountId], references: [id])
  amount           Decimal        @db.Decimal(12, 2)
  paymentMode      PaymentMode    @default(CASH)
  narration        String?
  voucherRef       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ============================================================
// CASH BOOK
// ============================================================

model CashBook {
  id             Int          @id @default(autoincrement())
  date           DateTime     @default(now())
  type           CashBookType
  amount         Decimal      @db.Decimal(12, 2)
  narration      String?
  voucherRef     String?
  runningBalance Decimal      @db.Decimal(12, 2)
  referenceId    Int?
  referenceType  String?
  createdAt      DateTime     @default(now())

  @@index([date])
  @@index([referenceType])
}

// ============================================================
// BANK LEDGER
// ============================================================

model BankLedger {
  id             Int             @id @default(autoincrement())
  date           DateTime        @default(now())
  bankName       String
  type           LedgerEntryType
  refNo          String?
  amount         Decimal         @db.Decimal(12, 2)
  narration      String?
  runningBalance Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
}

// ============================================================
// EASYPAISA LEDGER
// ============================================================

model EasypaisaLedger {
  id             Int             @id @default(autoincrement())
  date           DateTime        @default(now())
  mobileNo       String?
  type           LedgerEntryType
  amount         Decimal         @db.Decimal(12, 2)
  narration      String?
  runningBalance Decimal         @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
}

// ============================================================
// CHEQUE LOG
// ============================================================

model ChequeLog {
  id           Int          @id @default(autoincrement())
  chequeNo     String
  bankName     String
  chequeDate   DateTime
  amount       Decimal      @db.Decimal(12, 2)
  receivedFrom String?
  sourceType   String?
  sourceId     Int?
  paymentMode  PaymentMode  @default(CHEQUE)
  status       ChequeStatus @default(PENDING)
  notes        String?
  purchase     PurchaseEntry? @relation("PurchaseChequeLog")
  invoice      Invoice?       @relation("InvoiceChequeLog")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ============================================================
// ONLINE PAYMENT LOG
// ============================================================

model OnlinePaymentLog {
  id          Int             @id @default(autoincrement())
  provider    OnlineProvider
  referenceNo String?
  amount      Decimal         @db.Decimal(12, 2)
  status      PaymentStatus   @default(PENDING)
  receivedFrom String?
  sourceType  String?
  sourceId    Int?
  notes       String?
  purchase    PurchaseEntry?  @relation("PurchaseOnlinePaymentLog")
  invoice     Invoice?        @relation("InvoiceOnlinePaymentLog")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ============================================================
// TRANSPORT ADVANCE
// ============================================================

model TransportAdvance {
  id          Int         @id @default(autoincrement())
  date        DateTime    @default(now())
  driverId    Int
  driver      Driver      @relation(fields: [driverId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @default(CASH)
  purpose     String?
  voucherRef  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ============================================================
// DAILY REPORT SNAPSHOT
// ============================================================

model DailyReport {
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  purchaseWt   Decimal  @db.Decimal(10, 3)
  soldWt       Decimal  @db.Decimal(10, 3)
  remainShort  Decimal  @db.Decimal(10, 3)
  purchaseAmt  Decimal  @db.Decimal(12, 2)
  salesAmt     Decimal  @db.Decimal(12, 2)
  grossProfit  Decimal  @db.Decimal(12, 2)
  totalExpenses Decimal @db.Decimal(12, 2)
  dailyProfit  Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
